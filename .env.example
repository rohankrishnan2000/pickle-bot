TELEGRAM_BOT_TOKEN=token-from-BotFather

# Your numeric chat_id — gets approval requests when new users hit the bot.
# This chat_id is auto-allowed.
TELEGRAM_ADMIN_CHAT_ID=your-numeric-chat-id

# Optional: pre-approved chat_ids (comma-separated). New users can also be
# approved at runtime via the inline buttons sent to the admin.
TELEGRAM_ALLOWED_CHAT_IDS=

# Optional default yourcourts.com credentials (only used by the CLI scripts
# and bench_booking.py). The Telegram bot uses per-user creds via /login.
YC_EMAIL=
YC_PASSWORD=
